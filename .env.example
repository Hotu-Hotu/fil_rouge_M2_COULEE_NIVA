# Copier ce fichier en .env et adapter les valeurs. Le fichier .env n'est jamais commite.

ENVIRONMENT=local

# Base de donnees (docker compose up -d db)
POSTGRES_DB=transcription
POSTGRES_USER=transcription
POSTGRES_PASSWORD=transcription
DATABASE_URL=postgresql+asyncpg://transcription:transcription@localhost:5432/transcription

# Dossier des fichiers recus et des resultats
DATA_DIR=data

# Modele de transcription
TRANSCRIBER=whisper
MODEL_NAME=openai/whisper-medium.en

# Taille des fichiers, en Mo
WARN_SIZE_MB=500
MAX_SIZE_MB=2000

# Conservation des donnees (docs/decisions.md)
USER_RETENTION_HOURS=24
DATASET_RETENTION_DAYS=90

# Worker
WORKER_NAME=worker-1
