# Ignore everything except the code, its dependencies and the docs.
*
!*/
!.gitignore
!pyproject.toml
!requirements/*.txt
!src/**/*.py
!tests/**/*.py
!docs/*.md
!poc/test_pipeline_3.py

# never commit environments, secrets, caches, data or results
.venv/
.env
**/__pycache__/
.pytest_cache/
.ruff_cache/
data/
output/
